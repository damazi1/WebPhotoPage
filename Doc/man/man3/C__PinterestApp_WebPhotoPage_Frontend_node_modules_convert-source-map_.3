.SH NAME
Dokumentacja katalogu C:/PinterestApp/WebPhotoPage/Frontend/node_modules/convert-source-map
.SH SYNOPSIS
.br
.PP
.SH "Opis szczegółowy"
.PP 

.SH "convert-source-map [![Build Status][ci-image]][ci-url]"
.PP
Converts a source-map from/to different formats and allows adding/changing properties\&.

.PP
.PP
.nf
var convert = require('convert\-source\-map');

var json = convert
  \&.fromComment('//# sourceMappingURL=data:application/json;base64,eyJ2ZXJzaW9uIjozLCJmaWxlIjoiYnVpbGQvZm9vLm1pbi5qcyIsInNvdXJjZXMiOlsic3JjL2Zvby5qcyJdLCJuYW1lcyI6W10sIm1hcHBpbmdzIjoiQUFBQSIsInNvdXJjZVJvb3QiOiIvIn0=')
  \&.toJSON();

var modified = convert
  \&.fromComment('//# sourceMappingURL=data:application/json;base64,eyJ2ZXJzaW9uIjozLCJmaWxlIjoiYnVpbGQvZm9vLm1pbi5qcyIsInNvdXJjZXMiOlsic3JjL2Zvby5qcyJdLCJuYW1lcyI6W10sIm1hcHBpbmdzIjoiQUFBQSIsInNvdXJjZVJvb3QiOiIvIn0=')
  \&.setProperty('sources', [ 'SRC/FOO\&.JS' ])
  \&.toJSON();

console\&.log(json);
console\&.log(modified);
.fi
.PP

.PP
.PP
.nf
{"version":3,"file":"build/foo\&.min\&.js","sources":["src/foo\&.js"],"names":[],"mappings":"AAAA","sourceRoot":"/"}
{"version":3,"file":"build/foo\&.min\&.js","sources":["SRC/FOO\&.JS"],"names":[],"mappings":"AAAA","sourceRoot":"/"}
.fi
.PP
.SH "Upgrading"
.PP
Prior to v2\&.0\&.0, the \fRfromMapFileComment\fP and \fRfromMapFileSource\fP functions took a String directory path and used that to resolve & read the source map file from the filesystem\&. However, this made the library limited to nodejs environments and broke on sources with querystrings\&.

.PP
In v2\&.0\&.0, you now need to pass a function that does the file reading\&. It will receive the source filename as a String that you can resolve to a filesystem path, URL, or anything else\&.

.PP
If you are using \fRconvert-source-map\fP in nodejs and want the previous behavior, you'll use a function like such:

.PP
.PP
.nf
+ var fs = require('fs'); // Import the fs module to read a file
+ var path = require('path'); // Import the path module to resolve a path against your directory
\- var conv = convert\&.fromMapFileSource(css, '\&.\&./my\-dir');
+ var conv = convert\&.fromMapFileSource(css, function (filename) {
+   return fs\&.readFileSync(path\&.resolve('\&.\&./my\-dir', filename), 'utf\-8');
+ });
.fi
.PP
.SH "API"
.PP
.SS "fromObject(obj)"
Returns source map converter from given object\&.
.SS "fromJSON(json)"
Returns source map converter from given json string\&.
.SS "fromURI(uri)"
Returns source map converter from given uri encoded json string\&.
.SS "fromBase64(base64)"
Returns source map converter from given base64 encoded json string\&.
.SS "fromComment(comment)"
Returns source map converter from given base64 or uri encoded json string prefixed with \fR//# sourceMappingURL=\&.\&.\&.\fP\&.
.SS "fromMapFileComment(comment, readMap)"
Returns source map converter from given \fRfilename\fP by parsing \fR//# sourceMappingURL=filename\fP\&.

.PP
\fRreadMap\fP must be a function which receives the source map filename and returns either a String or Buffer of the source map (if read synchronously), or a \fRPromise\fP containing a String or Buffer of the source map (if read asynchronously)\&.

.PP
If \fRreadMap\fP doesn't return a \fRPromise\fP, \fRfromMapFileComment\fP will return a source map converter synchronously\&.

.PP
If \fRreadMap\fP returns a \fRPromise\fP, \fRfromMapFileComment\fP will also return \fRPromise\fP\&. The \fRPromise\fP will be either resolved with the source map converter or rejected with an error\&.
.SS "Examples"
\fBSynchronous read in Node\&.js:\fP

.PP
.PP
.nf
var convert = require('convert\-source\-map');
var fs = require('fs');

function readMap(filename) {
  return fs\&.readFileSync(filename, 'utf8');
}

var json = convert
  \&.fromMapFileComment('//# sourceMappingURL=map\-file\-comment\&.css\&.map', readMap)
  \&.toJSON();
console\&.log(json);
.fi
.PP

.PP
\fBAsynchronous read in Node\&.js:\fP

.PP
.PP
.nf
var convert = require('convert\-source\-map');
var { promises: fs } = require('fs'); // Notice the `promises` import

function readMap(filename) {
  return fs\&.readFile(filename, 'utf8');
}

var converter = await convert\&.fromMapFileComment('//# sourceMappingURL=map\-file\-comment\&.css\&.map', readMap)
var json = converter\&.toJSON();
console\&.log(json);
.fi
.PP

.PP
\fBAsynchronous read in the browser:\fP

.PP
.PP
.nf
var convert = require('convert\-source\-map');

async function readMap(url) {
  const res = await fetch(url);
  return res\&.text();
}

const converter = await convert\&.fromMapFileComment('//# sourceMappingURL=map\-file\-comment\&.css\&.map', readMap)
var json = converter\&.toJSON();
console\&.log(json);
.fi
.PP
.SS "fromSource(source)"
Finds last sourcemap comment in file and returns source map converter or returns \fRnull\fP if no source map comment was found\&.
.SS "fromMapFileSource(source, readMap)"
Finds last sourcemap comment in file and returns source map converter or returns \fRnull\fP if no source map comment was found\&.

.PP
\fRreadMap\fP must be a function which receives the source map filename and returns either a String or Buffer of the source map (if read synchronously), or a \fRPromise\fP containing a String or Buffer of the source map (if read asynchronously)\&.

.PP
If \fRreadMap\fP doesn't return a \fRPromise\fP, \fRfromMapFileSource\fP will return a source map converter synchronously\&.

.PP
If \fRreadMap\fP returns a \fRPromise\fP, \fRfromMapFileSource\fP will also return \fRPromise\fP\&. The \fRPromise\fP will be either resolved with the source map converter or rejected with an error\&.
.SS "toObject()"
Returns a copy of the underlying source map\&.
.SS "toJSON([space])"
Converts source map to json string\&. If \fRspace\fP is given (optional), this will be passed to \fRJSON\&.stringify\fP when the JSON string is generated\&.
.SS "toURI()"
Converts source map to uri encoded json string\&.
.SS "toBase64()"
Converts source map to base64 encoded json string\&.
.SS "toComment([options])"
Converts source map to an inline comment that can be appended to the source-file\&.

.PP
By default, the comment is formatted like: \fR//# sourceMappingURL=\&.\&.\&.\fP, which you would normally see in a JS source file\&.

.PP
When \fRoptions\&.encoding == 'uri'\fP, the data will be uri encoded, otherwise they will be base64 encoded\&.

.PP
When \fRoptions\&.multiline == true\fP, the comment is formatted like: \fR/*# sourceMappingURL=\&.\&.\&. */\fP, which you would find in a CSS source file\&.
.SS "addProperty(key, value)"
Adds given property to the source map\&. Throws an error if property already exists\&.
.SS "setProperty(key, value)"
Sets given property to the source map\&. If property doesn't exist it is added, otherwise its value is updated\&.
.SS "getProperty(key)"
Gets given property of the source map\&.
.SS "removeComments(src)"
Returns \fRsrc\fP with all source map comments removed
.SS "removeMapFileComments(src)"
Returns \fRsrc\fP with all source map comments pointing to map files removed\&.
.SS "commentRegex"
Provides \fBa fresh\fP RegExp each time it is accessed\&. Can be used to find source map comments\&.

.PP
Breaks down a source map comment into groups: Groups: 1: media type, 2: MIME type, 3: charset, 4: encoding, 5: data\&.
.SS "mapFileCommentRegex"
Provides \fBa fresh\fP RegExp each time it is accessed\&. Can be used to find source map comments pointing to map files\&.
.SS "generateMapFileComment(file, [options])"
Returns a comment that links to an external source map via \fRfile\fP\&.

.PP
By default, the comment is formatted like: \fR//# sourceMappingURL=\&.\&.\&.\fP, which you would normally see in a JS source file\&.

.PP
When \fRoptions\&.multiline == true\fP, the comment is formatted like: \fR/*# sourceMappingURL=\&.\&.\&. */\fP, which you would find in a CSS source file\&. 
