.SH "shebang-regex [![Build Status](https://travis-ci.org/sindresorhus/shebang-regex.svg?branch=master)](https://travis-ci.org/sindresorhus/shebang-regex)"
.PP
.RS 4
Regular expression for matching a \fRshebang\fP line 
.RE
.PP
.SH "Install"
.PP
.PP
.nf
$ npm install shebang\-regex
.fi
.PP
.SH "Usage"
.PP
.PP
.nf
const shebangRegex = require('shebang\-regex');

const string = '#!/usr/bin/env node\\nconsole\&.log("unicorns");';

shebangRegex\&.test(string);
//=> true

shebangRegex\&.exec(string)[0];
//=> '#!/usr/bin/env node'

shebangRegex\&.exec(string)[1];
//=> '/usr/bin/env node'
.fi
.PP
